ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_strong_workspace_password
DATABASE_URL=sqlite:///./data/triage.db
# On Vercel, use the hosted database's pooled URL instead:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Neon Marketplace also injects POSTGRES_URL, which the backend accepts.
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Optional separate embedding key; blank uses OPENROUTER_API_KEY.
OPENROUTER_EMBEDDING_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Only :free model IDs are accepted. Paid endpoints are blocked in code.
GENERATION_MODEL=nvidia/nemotron-3-super-120b-a12b:free
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
RETRIEVAL_THRESHOLD=0.35
INFERENCE_TIMEOUT=60
JOB_TIMEOUT=240
MAX_INDEX_CHUNKS=256
AUTO_MIGRATE=true
COOKIE_SECURE=false
# Set COOKIE_SECURE=true on Vercel (HTTPS).
