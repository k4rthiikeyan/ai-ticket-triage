{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "buildCommand": "npm ci --prefix frontend && npm run build --prefix frontend",
  "functions": {
    "backend/app/main.py": {
      "maxDuration": 300,
      "includeFiles": "{backend/**,frontend/dist/**}"
    }
  }
}
